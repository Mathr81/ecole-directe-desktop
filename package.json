{
  "name": "ecole-directe-desktop",
  "productName": "Mon EcoleDirecte",
  "version": "2.4.0",
  "description": "Une application desktop pour ÉcoleDirecte, avec authentification par API",
  "main": "src/main/index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "test": "node --test \"test/*.test.js\"",
    "patch": "node scripts/patch-extension.js",
    "prestart": "npm run patch",
    "prebuild": "node scripts/patch-extension.js",
    "build": "electron-builder",
    "prebuild:publish": "node scripts/patch-extension.js",
    "build:publish": "electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps && npm run patch"
  },
  "keywords": [],
  "author": "Mathr81",
  "license": "MIT",
  "dependencies": {
    "electron-chrome-extensions": "^4.9.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "desktop.ecole-directe.app",
    "productName": "Mon EcoleDirecte",
    "publish": {
      "provider": "github",
      "owner": "Mathr81",
      "repo": "ecole-directe-desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mon EcoleDirecte"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.education",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Mon EcoleDirecte"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png",
      "category": "Education",
      "maintainer": "Mathr81"
    },
    "files": [
      "**/*",
      "!userData/**",
      "!dist/**",
      "!.cache/**",
      "!.git/**",
      "!CustomDirecte/**",
      "!api-researchs/**",
      "!docs/**",
      "!test/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": ".cache/extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
